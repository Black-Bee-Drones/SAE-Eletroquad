<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeid="pf3"?>
<package format="3">
  <name>slalom</name>
  <version>0.0.0</version>
  <description>Autonomous drone slalom mission package</description>
  <maintainer email="samuellimabraz@gmail.com">samuel</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>yasmin</depend>
  <depend>yasmin_ros</depend>
  <depend>yasmin_viewer</depend>
  <depend>mirela_sdk</depend>
  <depend>mirela_interfaces</depend>
  <depend>mavros_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
